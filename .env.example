# CyberCanon — the environment, documented.
#
# Configuration is environment variables with **no file fallback**
# (openspec/project.md). This file is documentation and a starting point for a
# developer's own shell; nothing in the product reads it, and a `.env` sitting
# beside a service is a file somebody left there rather than configuration.
#
# Every value below is a placeholder. **No real credential is ever committed**,
# here or anywhere else in this repository, and tests/tooling/test_secret_scan.py
# fails the build over one.
#
# The service's required variables are documented in deploy/README.md, which is
# checked against the settings table the code actually reads
# (libs/cybercanon/adapters/wiring/configuration.py). What is repeated here is
# the optional half a developer most often wants locally.

# ---------------------------------------------------------------------------
# Language and vision models (add-derived-metadata)
# ---------------------------------------------------------------------------
#
# All seven are optional and the master switch defaults to **off**. With
# CANON_LLM_ENABLED unset, every other capability works and the model-backed
# features report themselves unavailable — which is the ordinary, fully
# supported state, not a degraded one.
#
# One wire format: the OpenAI-compatible Chat Completions API. The same build
# points at OpenAI, at the on-prem AminiLLM/LiteLLM gateway, or at any
# compatible proxy, by changing CANON_LLM_BASE_URL and nothing else.
#
# Model identifiers are **opaque strings**, passed through verbatim. There is no
# allow-list, no enum and no branch anywhere on their value, so a new model is a
# configuration change rather than a deploy.

# Master switch. Anything other than 1/true/yes/on is off.
CANON_LLM_ENABLED=false

# Any OpenAI-compatible endpoint, including the /v1 suffix if it has one.
# Pointing this at the on-prem gateway is what keeps unreleased concept art on
# the premises, and it makes that a deployment decision rather than a product
# argument.
CANON_LLM_BASE_URL=http://10.10.20.4:4000/v1

# Bearer credential for that endpoint. A private gateway that accepts
# unauthenticated calls needs none, so this may be left empty.
CANON_LLM_API_KEY=

# The text model identifier, verbatim.
CANON_LLM_MODEL=chat-v1

# The multimodal model identifier for image description, verbatim. Configured
# separately, so "text available, vision unavailable" is a real state.
CANON_LLM_VISION_MODEL=vision-v1

# The failure budget: how long one request may take, and how many times a
# transient failure is tried again. An authentication failure and an invalid
# request are never retried.
CANON_LLM_TIMEOUT_S=30
CANON_LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# CyberArche, the document platform (add-cyberarche-integration)
# ---------------------------------------------------------------------------
#
# Optional in exactly the same way: with CANON_ARCHE_ENABLED unset, linked
# documents report themselves unavailable and everything else works.

CANON_ARCHE_ENABLED=false
CANON_ARCHE_BASE_URL=
CANON_ARCHE_DEFAULT_WORKSPACE=
CANON_ARCHE_TIMEOUT_S=5
CANON_ARCHE_WEB_URL=
